{
  "name": "workverse-backend",
  "version": "1.0.0",
  "description": "Workverse Production Backend API with SQLite WAL persistence, JWT authentication, and Escrow disbursements",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node test-runner.js",
    "test:api": "node test-api.js",
    "test:db": "node test-db.js",
    "test:health": "node -e \"fetch('http://localhost:5000/api/health').then(r=>r.json()).then(d=>{console.log('Status:', d.status, '| DB:', d.database); process.exit(d.status==='ok'?0:1)})\"",
    "test:live": "node test-live-data.js",
    "backup": "node backup.js",
    "backup:list": "node backup.js --list",
    "db:seed": "node seed.js",
    "db:seed:fresh": "node seed.js --fresh"
  },
  "keywords": [
    "workverse",
    "freelance-marketplace",
    "sqlite-wal",
    "rest-api",
    "escrow"
  ],
  "author": "Workverse Core Engineering",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3"
  }
}
